# 安装包与产物都不进 git（体积大，且官方二进制不宜再分发）
packages/*
!packages/.gitkeep

build/*
!build/.gitkeep

logs/*
!logs/.gitkeep

.state/

# 原生调研的工作目录（Electron/解包产物）与 Rust 构建产物
native/work/
native/libzrpc/target/
native/player/target/
native/player/selftest/media/
native/player/selftest/out/

# 临时与中间产物
*.part
*.tmp
*.deb
*.exe
*.7z
__pycache__/

# 编辑器
.vscode/
.idea/
*~

# 会话工作目录
.workbuddy/
