QListWidget#liveChannelList {background: transparent; border: none; outline: none;}

QListWidget#liveGroupList {background: transparent; border: none; outline: none;}

QListWidget#liveGroupList::item {color: rgba(255,255,255,0.72); font-size: 14px; padding: 8px 8px; border-radius: 5px;}

QListWidget#liveGroupList::item:hover {color: #FFFFFF; background: rgba(255,255,255,0.10);}

QListWidget#liveGroupList::item:selected {color: #FFFFFF; background: rgba(255,255,255,0.15);}

