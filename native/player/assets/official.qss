/* 从官方 UZPlayer.exe 提取的 QSS 原文（逐条内联样式表汇总） */

QComboBox QAbstractItemView {background:#11131E;font-size:12px;color:rgba(255,255,255,0.8);outline:0px;}

QComboBox QAbstractItemView::item {background:#11131E;min-height: 30px;color:#FFFFFF;}

QComboBox QAbstractItemView::item:selected {background:rgba(187,197,255,0.15);min-height:30px;color:#FFFFFF;}

QComboBox::down-arrow {image: url(:/resource/setconfig/down-arrow.png);}

QLabel {color: rgba(255,255,255,0.55); font-size: 14px; background: transparent;}

QLabel#backlabel {border-image: url(:/resource/background.jpg);}

QLabel#labDefault {border-image: url(:/resource/selectitem/vector2x.png);}

QLabel#labErrorIcon {border-image: url(:/resource/popup/search2x.png);}

