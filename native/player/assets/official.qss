QScrollBar::add-line:vertical {background:transparent;height:0px;}

QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical {background:transparent;border-radius:3px;}

QScrollBar::handle:vertical {background:rgba(255, 255, 255, 0.15);min-height:10px;border-radius:3px;}

QScrollBar::sub-line:vertical {background:transparent;height:0px;}

QScrollBar:vertical {background:transparent;width:6px;margin:0px 0px 8px 0px;}

QSlider::add-page:horizontal {background: rgba(228,228,228,0.15);}

QSlider::handle:horizontal {background: transparent;}

QSlider::sub-page:horizontal {background: #425FFF;}

QWidget#Eoftip {border-radius: 10px;}

QWidget#backwidget {border-image: url(:/resource/rateback2x.png);}

QWidget#centralwidget {background: #141620;}

QWidget#errorshow {border-radius: 10px;}

QWidget#liveChannelItem {border-radius: 5px; border: 2px solid #FFFFFF; background: transparent;}

QWidget#liveChannelItem:hover {background: rgba(255,255,255,0.08);}

QWidget#playbegin {border-radius: 10px;}

QWidget#replaytip {border-radius: 10px;}

QWidget#scrollAreaWidgetContents {background:transparent;}

QWidget#subnoserch {border-radius: 10px;}

QWidget#topwidget {background: #141620;}

QWidget#videoloading {border-radius: 8px;}

QWidget#widButtons {border-right: 1px solid rgba(255,255,255,0.15);}

QWidget#widControl {background: linear-gradient( 180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.6) 55%, rgba(0,0,0,0.75) 100%), #141620;}

QWidget#widDetail {border-bottom: 1px solid rgba(255,255,255,0.15);}

QWidget#widEnd {background: transparent;}

QWidget#widHead {background: transparent;}

QWidget#widLiveBase {background: rgba(0,0,0,0.85);border-radius: 8px;border: 1px solid rgba(179,193,205,0.15);}

QWidget#widMouse {background: transparent;}

QWidget#widPointTo {background: transparent;}

QWidget#widShow {border-radius:5px;border:2px solid #FFFFFF;}

QWidget#widText {background: transparent;}

QWidget#widTitle {border-bottom: 1px solid rgba(255,255,255,0.15);}