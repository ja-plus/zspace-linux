[Desktop Entry]
Type=Application
Name=极空间
Name[en]=ZSpace
GenericName=私有云客户端
Comment=极空间私有云客户端
Exec=/opt/durapps/com.zspace.native.spark/files/run.sh %U
Icon=com.zspace.native.spark
Terminal=false
Categories=Network;FileTransfer;
Keywords=zspace;极空间;nas;cloud;
# 实测主窗口 WM_CLASS = ("zspace", "zspace")；写 electron 会导致 Dock
# 匹配不到本条目，回落到齿轮图标。
StartupWMClass=zspace
StartupNotify=true
